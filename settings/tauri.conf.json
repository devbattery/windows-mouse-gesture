{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glide 설정",
  "version": "0.5.6",
  "identifier": "io.github.devbattery.glide-settings",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Glide 설정",
        "width": 980,
        "height": 860,
        "minWidth": 560,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
